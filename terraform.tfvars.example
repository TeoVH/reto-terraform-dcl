# Ejemplo de variables (valores NO sensibles).
# Uso: cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars no se versiona (está en .gitignore).

region        = "us-east-1"
team          = "team-03"
prefix        = "dcl-tf"
project       = "digital-cafe-luna"
environment   = "dev"
vpc_name      = "dcl-dev-vpc"
subnet_name   = "dcl-dev-subnet-public-a"
instance_type = "t3.micro"
